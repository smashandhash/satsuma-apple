        <mxCell id="dcRoc6hrVqIZSMx1CL75-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=17;fontStyle=1" value="Still not sure whether I should keep the Hide Message&#39;s Domain on its own or merge it with the Send Message&#39;s Domain." vertex="1">
          <mxGeometry height="140" width="330" x="1330" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="U8Ps1M72rNASgE0ytGYo-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=17;fontStyle=1" value="&lt;div&gt;Also not sure if I should make a whole new big domain for a Message, as it has various behavior.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Meaning, all 5 small domains should be in a single big domain.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A Message has:&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Send Message&lt;/li&gt;&lt;li&gt;Upload Images&lt;/li&gt;&lt;li&gt;Hide Message&lt;/li&gt;&lt;li&gt;Edit Message&lt;/li&gt;&lt;li&gt;Upload Files&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="330" x="1330" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="3mlGDRxuxvMW1X8H-vkl-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=17;fontStyle=1" value="&lt;div&gt;About separation of Thread and Reply Message, I don&#39;t know if I should make it into single behavior but different Effect, or stay different.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="330" x="945" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="IR4se3jtvmhNRh-FQ5UH-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=17;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;MessageStruct&lt;/h1&gt;&lt;p&gt;struct Message {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;let id: String&lt;/p&gt;&lt;p&gt;let kind: Int&lt;/p&gt;&lt;p&gt;let created_at: String&lt;/p&gt;&lt;p&gt;let pubkey: String&lt;/p&gt;&lt;p&gt;let content: String&lt;/p&gt;&lt;p&gt;let tags: [[String]]&lt;/p&gt;&lt;p&gt;let sig: String&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="400" width="270" x="40" y="1750" as="geometry" />
        </mxCell>
        <UserObject label="NIP-28 for either it&#39;s a main message or reply message" link="https://nips.nostr.com/28#kind-42-create-channel-message" id="W1j5TVyMAYBFL0-jifqj-1">
