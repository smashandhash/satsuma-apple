        <mxCell id="fLvd0Lv5x9115u4E1P_H-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ReplyMessageDomain&lt;/h1&gt;&lt;p&gt;struct ReplyMessageDomain {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;struct State: Equatable, Identifiable {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;let id: UUID&lt;/p&gt;&lt;p&gt;let replyMessage: Message&lt;/p&gt;&lt;p&gt;var text: String&lt;/p&gt;&lt;p&gt;var images: [Image]&lt;/p&gt;&lt;p&gt;var files: [File] ❓&lt;/p&gt;&lt;p&gt;var isEditingText: Bool&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;var sendMessageState = SendMessageDomain.State()&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;enum Action: Equatable {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;case sendMessage(SendMessageDomain.Action)&lt;/p&gt;&lt;p&gt;case uploadImages(UploadImagesDomain.Action)&lt;/p&gt;&lt;p&gt;case hideMessage(HideMessageDomain.Action)&lt;/p&gt;&lt;p&gt;case editMessage(EditMessageDomain.Action)&lt;/p&gt;&lt;p&gt;case uploadFiles(UploadFilesDomain.Action)&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;static let reducer = Reducer&amp;lt;State, Action, Environment&amp;gt;&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;.combine(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;SendMessageDomain.reducer.pullback(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;state: \.sendMessageState,&lt;/p&gt;&lt;p&gt;action: /ReplyMessageDomain.Action.sendMessage,&lt;/p&gt;&lt;p&gt;environment: { _ in&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;blockquote&gt;&lt;p&gt;SendMessageDomain.Environment()&lt;/p&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;),&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;p&gt;.init { state, action, environment in&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;switch action {&lt;/p&gt;&lt;p&gt;case sendMessage(.sendMessage), sendMessage(.editMessage):&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;state.text = ❓&lt;/p&gt;&lt;p&gt;state.images = ❓&lt;/p&gt;&lt;p&gt;state.files = ❓&lt;/p&gt;&lt;p&gt;state.isEditingText = ❓&lt;/p&gt;&lt;p&gt;return .none ❓&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;)&lt;/p&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
