        <mxCell id="NutQIlRFEjr5Sf_tc1tw-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;ReplyListDomain&lt;/h1&gt;&lt;p&gt;struct ReplyListDomain {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;struct State: Equatable {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;var replyListState: IdentifiedArrayOf&amp;lt;ReplyMessageDomain.State&amp;gt; = []&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;enum Action: Equatable {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;case fetchReplyList&lt;/p&gt;&lt;p&gt;case replyMessage(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;id: ReplyMessageDomain.State.ID,&amp;nbsp;&lt;/p&gt;&lt;p&gt;action: ReplyMessageDomain.Action&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;)&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;struct Environment {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;var fetchReplyList: () -&amp;gt; [ReplyMessage]&lt;/p&gt;&lt;p&gt;var uuid: () -&amp;gt; UUID&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;static let reducer = Reducer&amp;lt;State, Action, Environment&amp;gt;&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;.combine(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;ReplyMessageDomain.reducer.forEach(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;state: \.replyListState,&lt;/p&gt;&lt;p&gt;action: /ReplyListDomain.Action.replyMessage(id:action:),&lt;/p&gt;&lt;p&gt;environment: { _ in&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;blockquote&gt;&lt;p&gt;ReplyMessageDomain.Environment()&lt;/p&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;),&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote&gt;&lt;p&gt;.init { state, action, environment in&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;switch action {&lt;/p&gt;&lt;p&gt;case fetchReplyList:&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;state.replyListState = IdentifiedArrayOf(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;uniqueElements: environment.fetchReplyList().map {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;ReplyMessageDomain.State(&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;id: environment.uuid(),&lt;/p&gt;&lt;p&gt;replyMessage: $0&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;)&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;)&lt;/p&gt;&lt;/blockquote&gt;&lt;blockquote&gt;return .none&amp;nbsp;❓&lt;/blockquote&gt;&lt;p&gt;case replyMessage(let id, let action):&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;return .none ❓&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;)&lt;/p&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
