        <mxCell id="RxpwM8HYUpafQqP38944-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageState&lt;/h1&gt;&lt;p&gt;struct State: Equatable {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;var text: String&lt;/p&gt;&lt;p&gt;var images: [Image]&lt;/p&gt;&lt;p&gt;var files: [File] ❓&lt;/p&gt;&lt;p&gt;var isEditingText: Bool&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="230" x="80" y="800" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageAction&lt;/h1&gt;&lt;p&gt;enum Action: Equatable {&lt;/p&gt;&lt;blockquote&gt;case sendMessage&lt;br&gt;case editMessage&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="250" x="350" y="800" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageEnvironment&lt;/h1&gt;&lt;p&gt;struct Environment {&lt;/p&gt;&lt;blockquote&gt;// Future dependencies...&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="320" x="640" y="800" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageReducer&lt;/h1&gt;&lt;div&gt;let reducer = Reducer&amp;lt;State, Action, Environment&amp;gt; { state, action, environment in&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;switch action {&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;case .sendMessage:&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;// TODO: I think this one talks with the Effect to the Repository layer&lt;/div&gt;&lt;div&gt;return Effect.none&lt;/div&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="610" x="1000" y="800" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageButton&lt;/h1&gt;&lt;div&gt;Button {&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;viewStore.send(.sendMessage)&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;} label : {&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;// Button layout...&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;.buttonStyle(.plain)&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="250" x="760" y="355" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-5" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;EditMessageButton&lt;/h1&gt;&lt;div&gt;Button {&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;viewStore.send(.editMessage)&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;} label : {&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;// Button layout...&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;.buttonStyle(.plain)&lt;/div&gt;" vertex="1">
          <mxGeometry height="195" width="250" x="1090" y="355" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-6" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageStore&lt;/h1&gt;&lt;div&gt;ContentView(&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;store: Store(&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;initialState: SendMessageState(),&lt;/div&gt;&lt;div&gt;reducer: reducer,&lt;/div&gt;&lt;div&gt;environment: Environment()&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;)&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;)&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="350" x="760" y="50" as="geometry" />
        </mxCell>
        <mxCell id="qf9b9YnzeF1UYCDV6wAb-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;SendMessageDomain&lt;/h1&gt;&lt;div&gt;struct SendMessageDomain {&lt;/div&gt;&lt;blockquote&gt;&lt;p&gt;struct State: Equatable {&lt;/p&gt;&lt;blockquote&gt;&lt;p&gt;var text: String&lt;/p&gt;&lt;p&gt;var images: [Image]&lt;/p&gt;&lt;p&gt;var files: [File] ❓&lt;/p&gt;&lt;p&gt;var isEditingText: Bool&lt;/p&gt;&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;enum Action: Equatable {&lt;/p&gt;&lt;blockquote&gt;case sendMessage&lt;br&gt;case editMessage&lt;/blockquote&gt;&lt;p&gt;}&lt;/p&gt;&lt;p&gt;struct Environment {}&lt;/p&gt;&lt;div&gt;let reducer = Reducer&amp;lt;State, Action, Environment&amp;gt; { state, action, environment in&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;switch action {&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;case .sendMessage:&lt;/div&gt;&lt;blockquote&gt;&lt;div&gt;// TODO: I think this one talks with the Effect to the Repository layer&lt;/div&gt;&lt;div&gt;return Effect.none&lt;/div&gt;&lt;/blockquote&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;&lt;/blockquote&gt;&lt;div&gt;}&lt;/div&gt;" vertex="1">
